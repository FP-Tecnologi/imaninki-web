# API central del HUB y marcaId de imaninki (tabla Marca; ver /public/marcas). Sin HUB_MARCA_ID la web usa sus textos y líneas de respaldo,
# y los formularios (contacto, tickets, libro de reclamaciones) responden 503.
HUB_API_URL=http://localhost:3001
HUB_MARCA_ID=

# URL del dashboard (puede mostrar esta web en la vista previa del editor).
DASHBOARD_ORIGIN=http://localhost:3000

# Opcional: CDN solo para archivos (p. ej. https://cdn.imaninki.com). Sin esta variable no cambia nada. Ver docs/CDN-CLOUDFLARE.md.
CDN_URL=
